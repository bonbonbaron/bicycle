# Dependencies for bicycle, fetched and built from source at configure time when they aren't on the system, so a
# compiler, CMake and Ninja/Make are all you need:
#   curses     PDCurses 3.9 (Windows console, compiled into the build); ncurses elsewhere (system, else 6.5 from source)
#   LuaJIT     2.1 (pinned commit; built with its own Makefile, or msvcbuild.bat under MSVC)
#   fluidsynth 2.6.1 (C++11 threads instead of glib; no libsndfile/jack/sdl/...; WASAPI/DirectSound/WaveOut on
#              Windows, ALSA/PulseAudio on Linux when their headers are installed)
#   A General MIDI SoundFont (GeneralUser GS) into ./sf2/default-GM.sf2, the engine's music fallback.
#   miniz      3.0.2, deflate for the asset packer (tools/pack); the engine inflates with jollybean's tinfl
#   SDL3       3.4.18 for the 2D and 3D render modes (static)
# Everything is static, so o.exe doesn't need DLLs from these. Downloads and builds land in <build>/_deps and are
# reused by later configures; delete that folder to rebuild them.
#
# BICYCLE_USE_SYSTEM_DEPS=ON prefers installed packages (pkg-config or CMake packages) and only fetches what's missing.
include_guard( GLOBAL )

option( BICYCLE_USE_SYSTEM_DEPS "Prefer installed LuaJIT/fluidsynth/curses; fetch only what's missing" OFF )
option( BICYCLE_FETCH_NCURSES "Build ncurses from source even if the system has it (not on Windows)" OFF )
option( BICYCLE_DOWNLOAD_GM_SF2 "Download a General MIDI SoundFont to sf2/default-GM.sf2 if there isn't one" ON )
set( BICYCLE_DEPS_DIR "${CMAKE_BINARY_DIR}/_deps" CACHE PATH "Where fetched dependencies are downloaded, built and installed" )
set( BICYCLE_DEPS_PREFIX "${BICYCLE_DEPS_DIR}/prefix" )

set( BICYCLE_LUAJIT_URL "https://github.com/LuaJIT/LuaJIT/archive/2a8e017ef1ece6a95b983ffca073d30609dce7c4.tar.gz" )
set( BICYCLE_LUAJIT_SHA256 54705d4b1de50a9c668539b9cf0dc3170d94ffdad51fafd1cf4477e498be7144 )
set( BICYCLE_FLUIDSYNTH_URL "https://github.com/FluidSynth/fluidsynth/archive/refs/tags/v2.6.1.tar.gz" )
set( BICYCLE_FLUIDSYNTH_SHA256 3d258a3bf97cc20c59eeebfe62c2432fae88adda74d3ad098681c76e0ebf446b )
set( BICYCLE_PDCURSES_URL "https://github.com/wmcbrine/PDCurses/archive/refs/tags/3.9.tar.gz" )
set( BICYCLE_PDCURSES_SHA256 590dbe0f5835f66992df096d3602d0271103f90cf8557a5d124f693c2b40d7ec )
set( BICYCLE_NCURSES_URL "https://invisible-island.net/archives/ncurses/ncurses-6.5.tar.gz" )
set( BICYCLE_NCURSES_SHA256 136d91bc269a9a5785e5f9e980bc76ab57428f604ce3e5a5a90cebc767971cc6 )
# GeneralUser GS by S. Christian Collins (free to use and redistribute), pinned to a commit.
set( BICYCLE_GM_SF2_URL "https://github.com/mrbumpy409/GeneralUser-GS/raw/97049183643d5fc5a9322a69c5b09efb667c6c3a/GeneralUser-GS.sf2" )
set( BICYCLE_GM_SF2_SHA256 9575028c7a1f589f5770fccc8cff2734566af40cd26ed836944e9a5152688cfe )

set( BICYCLE_MINIZ_URL "https://github.com/richgel999/miniz/releases/download/3.0.2/miniz-3.0.2.zip" )
set( BICYCLE_MINIZ_SHA256 ada38db0b703a56d3dd6d57bf84a9c5d664921d870d8fea4db153979fb5332c5 )
set( BICYCLE_SDL3_URL "https://github.com/libsdl-org/SDL/archive/refs/tags/release-3.4.18.tar.gz" )
set( BICYCLE_SDL3_SHA256 c4b08b950bd29d83caae0ab8d884298d27046a9d30700fb42841c50992665c90 )

include( ProcessorCount )
ProcessorCount( BICYCLE_JOBS )
if ( BICYCLE_JOBS EQUAL 0 )
  set( BICYCLE_JOBS 4 )
endif()

# Downloads (once, checking the hash) and unpacks an archive; sets outVar to the unpacked source folder.
function( bicycle_fetch name url sha256 outVar )
  set( archive "${BICYCLE_DEPS_DIR}/download/${name}.tar.gz" )
  set( src "${BICYCLE_DEPS_DIR}/src/${name}" )
  if ( NOT EXISTS "${src}/.bicycle-unpacked" )
    if ( NOT EXISTS "${archive}" )
      message( STATUS "bicycle: downloading ${name} from ${url}" )
      file( DOWNLOAD "${url}" "${archive}.part" EXPECTED_HASH SHA256=${sha256} STATUS status TLS_VERIFY ON )
      list( GET status 0 code )
      if ( NOT code EQUAL 0 )
        file( REMOVE "${archive}.part" )
        message( FATAL_ERROR "bicycle: couldn't download ${name}: ${status}" )
      endif()
      file( RENAME "${archive}.part" "${archive}" )
    endif()
    file( REMOVE_RECURSE "${src}" "${src}.tmp" )
    file( ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${src}.tmp" )
    file( GLOB top LIST_DIRECTORIES true "${src}.tmp/*" )  # archives hold one top-level folder
    list( LENGTH top n )
    if ( n EQUAL 1 AND IS_DIRECTORY "${top}" )
      file( RENAME "${top}" "${src}" )
      file( REMOVE_RECURSE "${src}.tmp" )
    else()
      file( RENAME "${src}.tmp" "${src}" )
    endif()
    file( TOUCH "${src}/.bicycle-unpacked" )
  endif()
  set( ${outVar} "${src}" PARENT_SCOPE )
endfunction()

function( bicycle_run what )
  execute_process( COMMAND ${ARGN} RESULT_VARIABLE result )
  if ( NOT result EQUAL 0 )
    message( FATAL_ERROR "bicycle: ${what} failed (${result}). See the output above." )
  endif()
endfunction()

# Configures, builds and installs a CMake project into BICYCLE_DEPS_PREFIX with this build's compilers.
function( bicycle_build_cmake_dep name src )
  set( stamp "${BICYCLE_DEPS_PREFIX}/.${name}-installed" )
  if ( EXISTS "${stamp}" )
    return()
  endif()
  set( bin "${BICYCLE_DEPS_DIR}/build/${name}" )
  set( args -S "${src}" -B "${bin}" -G "${CMAKE_GENERATOR}"
    "-DCMAKE_INSTALL_PREFIX=${BICYCLE_DEPS_PREFIX}" -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF
    -DCMAKE_POLICY_DEFAULT_CMP0091=NEW -DCMAKE_MSVC_RUNTIME_LIBRARY=MultiThreadedDLL
    -DCMAKE_POSITION_INDEPENDENT_CODE=ON )
  if ( CMAKE_GENERATOR_PLATFORM )
    list( APPEND args -A "${CMAKE_GENERATOR_PLATFORM}" )
  endif()
  if ( CMAKE_GENERATOR_TOOLSET )
    list( APPEND args -T "${CMAKE_GENERATOR_TOOLSET}" )
  endif()
  if ( CMAKE_TOOLCHAIN_FILE )
    list( APPEND args "-DCMAKE_TOOLCHAIN_FILE=${CMAKE_TOOLCHAIN_FILE}" )
  endif()
  if ( NOT CMAKE_GENERATOR MATCHES "Visual Studio" )
    list( APPEND args "-DCMAKE_C_COMPILER=${CMAKE_C_COMPILER}" "-DCMAKE_CXX_COMPILER=${CMAKE_CXX_COMPILER}" )
    if ( CMAKE_MAKE_PROGRAM )
      list( APPEND args "-DCMAKE_MAKE_PROGRAM=${CMAKE_MAKE_PROGRAM}" )
    endif()
  endif()
  message( STATUS "bicycle: building ${name} (first configure only; this takes a minute)" )
  bicycle_run( "configuring ${name}" "${CMAKE_COMMAND}" ${args} ${ARGN} )
  bicycle_run( "building ${name}" "${CMAKE_COMMAND}" --build "${bin}" --config Release --parallel ${BICYCLE_JOBS} )
  bicycle_run( "installing ${name}" "${CMAKE_COMMAND}" --install "${bin}" --config Release )
  file( TOUCH "${stamp}" )
endfunction()

# --- curses ------------------------------------------------------------------------------------------------------
function( bicycle_curses )
  if ( WIN32 )
    if ( BICYCLE_USE_SYSTEM_DEPS )
      find_path( PDCURSES_INCLUDE_DIR curses.h PATH_SUFFIXES pdcurses )
      find_library( PDCURSES_LIBRARY NAMES pdcurses libpdcurses pdcursesstatic )
      if ( PDCURSES_INCLUDE_DIR AND PDCURSES_LIBRARY )
        add_library( bicycle_curses INTERFACE )
        target_include_directories( bicycle_curses INTERFACE "${PDCURSES_INCLUDE_DIR}" )
        target_link_libraries( bicycle_curses INTERFACE "${PDCURSES_LIBRARY}" )
        message( STATUS "bicycle: PDCurses: ${PDCURSES_LIBRARY}" )
        return()
      endif()
    endif()
    # PDCurses has no CMake build of its own, but it's a handful of C files: compile its Windows console port here.
    bicycle_fetch( pdcurses "${BICYCLE_PDCURSES_URL}" ${BICYCLE_PDCURSES_SHA256} src )
    file( GLOB pdcSources "${src}/pdcurses/*.c" "${src}/wincon/*.c" )
    add_library( bicycle_curses STATIC ${pdcSources} )
    set_target_properties( bicycle_curses PROPERTIES LINKER_LANGUAGE C )
    target_include_directories( bicycle_curses PUBLIC "${src}" PRIVATE "${src}/wincon" )
    target_compile_definitions( bicycle_curses PUBLIC PDC_WIDE PDC_FORCE_UTF8 )
    if ( MSVC )
      target_compile_definitions( bicycle_curses PRIVATE _CRT_SECURE_NO_WARNINGS )
      target_compile_options( bicycle_curses PRIVATE /W0 )
    else()
      target_compile_options( bicycle_curses PRIVATE -w )
    endif()
    target_link_libraries( bicycle_curses PUBLIC user32 advapi32 )
    message( STATUS "bicycle: PDCurses 3.9 (fetched, built in)" )
    return()
  endif()
  # Elsewhere ncurses is practically always installed (and its terminfo database with it); use it.
  find_package( PkgConfig QUIET )
  if ( PKG_CONFIG_FOUND AND NOT BICYCLE_FETCH_NCURSES )
    pkg_check_modules( NCURSES_PC QUIET IMPORTED_TARGET ncurses )
    if ( NCURSES_PC_FOUND )
      add_library( bicycle_curses INTERFACE )
      target_link_libraries( bicycle_curses INTERFACE PkgConfig::NCURSES_PC )
      message( STATUS "bicycle: ncurses ${NCURSES_PC_VERSION} (system)" )
      return()
    endif()
  endif()
  if ( NOT BICYCLE_FETCH_NCURSES )
    find_package( Curses QUIET )
    if ( CURSES_FOUND )
      add_library( bicycle_curses INTERFACE )
      target_include_directories( bicycle_curses INTERFACE ${CURSES_INCLUDE_DIRS} )
      target_link_libraries( bicycle_curses INTERFACE ${CURSES_LIBRARIES} )
      message( STATUS "bicycle: curses ${CURSES_LIBRARIES} (system)" )
      return()
    endif()
  endif()
  # No ncurses: build it (needs a POSIX shell and make). It reads the system's terminfo database.
  set( stamp "${BICYCLE_DEPS_PREFIX}/.ncurses-installed" )
  if ( NOT EXISTS "${stamp}" )
    bicycle_fetch( ncurses "${BICYCLE_NCURSES_URL}" ${BICYCLE_NCURSES_SHA256} src )
    find_program( BICYCLE_MAKE NAMES gmake make REQUIRED )
    set( bin "${BICYCLE_DEPS_DIR}/build/ncurses" )
    file( MAKE_DIRECTORY "${bin}" )
    message( STATUS "bicycle: building ncurses 6.5 (first configure only; this takes a minute)" )
    bicycle_run( "configuring ncurses" "${CMAKE_COMMAND}" -E env "CC=${CMAKE_C_COMPILER}"
      sh "${src}/configure" "--prefix=${BICYCLE_DEPS_PREFIX}" --without-shared --without-debug --without-cxx
      --without-cxx-binding --without-ada --without-progs --without-tests --without-manpages --enable-overwrite
      --with-default-terminfo-dir=/usr/share/terminfo
      --with-terminfo-dirs=/etc/terminfo:/lib/terminfo:/usr/share/terminfo:/usr/lib/terminfo
      WORKING_DIRECTORY "${bin}" )
    bicycle_run( "building ncurses" "${BICYCLE_MAKE}" -C "${bin}" -j${BICYCLE_JOBS} libs )
    bicycle_run( "installing ncurses" "${BICYCLE_MAKE}" -C "${bin}" install.libs install.includes )
    file( TOUCH "${stamp}" )
  endif()
  add_library( bicycle_curses INTERFACE )
  target_include_directories( bicycle_curses INTERFACE "${BICYCLE_DEPS_PREFIX}/include" )
  target_link_libraries( bicycle_curses INTERFACE "${BICYCLE_DEPS_PREFIX}/lib/libncurses.a" )
  message( STATUS "bicycle: ncurses 6.5 (fetched)" )
endfunction()

# --- LuaJIT -------------------------------------------------------------------------------------------------------
function( bicycle_luajit )
  if ( BICYCLE_USE_SYSTEM_DEPS )
    find_package( PkgConfig QUIET )
    if ( PKG_CONFIG_FOUND )
      pkg_check_modules( LUAJIT_PC QUIET IMPORTED_TARGET luajit )
      if ( LUAJIT_PC_FOUND )
        add_library( bicycle_luajit INTERFACE )
        target_link_libraries( bicycle_luajit INTERFACE PkgConfig::LUAJIT_PC )
        message( STATUS "bicycle: LuaJIT ${LUAJIT_PC_VERSION} (system)" )
        return()
      endif()
    endif()
  endif()
  bicycle_fetch( luajit "${BICYCLE_LUAJIT_URL}" ${BICYCLE_LUAJIT_SHA256} src )
  if ( MSVC )
    set( lib "${src}/src/lua51.lib" )
  else()
    set( lib "${src}/src/libluajit.a" )
  endif()
  if ( NOT EXISTS "${lib}" )
    message( STATUS "bicycle: building LuaJIT (first configure only)" )
    if ( MSVC )
      # msvcbuild.bat needs cl.exe on PATH: configure from a "Developer Command Prompt/PowerShell for VS".
      bicycle_run( "building LuaJIT (msvcbuild.bat; run CMake from a VS Developer prompt)" cmd /c msvcbuild.bat static
        WORKING_DIRECTORY "${src}/src" )
    else()
      find_program( BICYCLE_MAKE NAMES gmake make mingw32-make REQUIRED )
      set( margs BUILDMODE=static "CC=${CMAKE_C_COMPILER}" CROSS= -j${BICYCLE_JOBS} )
      if ( CMAKE_AR )
        list( APPEND margs "TARGET_AR=${CMAKE_AR} rcus" )
      endif()
      if ( CMAKE_STRIP )
        list( APPEND margs "TARGET_STRIP=${CMAKE_STRIP}" )
      endif()
      if ( CMAKE_CROSSCOMPILING )
        # LuaJIT builds code generators (buildvm, minilua) for the build machine first.
        list( APPEND margs "HOST_CC=${BICYCLE_HOST_CC}" "TARGET_SYS=${CMAKE_SYSTEM_NAME}" )
      endif()
      if ( APPLE AND CMAKE_OSX_DEPLOYMENT_TARGET )
        list( APPEND margs "MACOSX_DEPLOYMENT_TARGET=${CMAKE_OSX_DEPLOYMENT_TARGET}" )
      endif()
      bicycle_run( "building LuaJIT" "${BICYCLE_MAKE}" -C "${src}/src" ${margs} libluajit.a )
    endif()
  endif()
  add_library( bicycle_luajit INTERFACE )
  target_include_directories( bicycle_luajit INTERFACE "${src}/src" )
  target_link_libraries( bicycle_luajit INTERFACE "${lib}" )
  if ( UNIX )
    target_link_libraries( bicycle_luajit INTERFACE ${CMAKE_DL_LIBS} m )
  endif()
  message( STATUS "bicycle: LuaJIT 2.1 (fetched): ${lib}" )
endfunction()
set( BICYCLE_HOST_CC "cc" CACHE STRING "Host C compiler for LuaJIT's build tools when cross-compiling" )

# --- fluidsynth ---------------------------------------------------------------------------------------------------
function( bicycle_fluidsynth )
  if ( BICYCLE_USE_SYSTEM_DEPS )
    find_package( FluidSynth CONFIG QUIET )
    if ( TARGET FluidSynth::libfluidsynth )
      add_library( bicycle_fluidsynth INTERFACE )
      target_link_libraries( bicycle_fluidsynth INTERFACE FluidSynth::libfluidsynth )
      message( STATUS "bicycle: fluidsynth ${FluidSynth_VERSION} (system)" )
      return()
    endif()
  endif()
  bicycle_fetch( fluidsynth "${BICYCLE_FLUIDSYNTH_URL}" ${BICYCLE_FLUIDSYNTH_SHA256} src )
  set( off )
  foreach( opt libsndfile jack dbus ladspa midishare network oss sdl3 pipewire readline openmp systemd libinstpatch
               signalsmith portaudio winmidi coreaudio coremidi ipv6 )
    list( APPEND off "-Denable-${opt}=OFF" )
  endforeach()
  bicycle_build_cmake_dep( fluidsynth "${src}" -Dosal=cpp11 ${off} -Denable-aufile=ON -Denable-threads=ON
    -Denable-alsa=ON -Denable-pulseaudio=ON -Denable-wasapi=ON -Denable-dsound=ON -Denable-waveout=ON
    -DCMAKE_DISABLE_FIND_PACKAGE_GLib2=ON )
  find_package( FluidSynth CONFIG REQUIRED PATHS "${BICYCLE_DEPS_PREFIX}" NO_DEFAULT_PATH )
  add_library( bicycle_fluidsynth INTERFACE )
  target_link_libraries( bicycle_fluidsynth INTERFACE FluidSynth::libfluidsynth )
  target_compile_definitions( bicycle_fluidsynth INTERFACE FLUIDSYNTH_NOT_A_DLL )
  message( STATUS "bicycle: fluidsynth 2.6.1 (fetched, static)" )
endfunction()

# --- General MIDI SoundFont ---------------------------------------------------------------------------------------
function( bicycle_gm_soundfont )
  set( dst "${CMAKE_SOURCE_DIR}/sf2/default-GM.sf2" )
  if ( NOT BICYCLE_DOWNLOAD_GM_SF2 OR EXISTS "${dst}" )
    return()
  endif()
  message( STATUS "bicycle: downloading the GeneralUser GS SoundFont (32 MB) to sf2/default-GM.sf2" )
  file( DOWNLOAD "${BICYCLE_GM_SF2_URL}" "${dst}.part" EXPECTED_HASH SHA256=${BICYCLE_GM_SF2_SHA256} STATUS status )
  list( GET status 0 code )
  if ( NOT code EQUAL 0 )
    file( REMOVE "${dst}.part" )
    message( WARNING "bicycle: couldn't download the General MIDI SoundFont (${status}); music falls back to the "
                     "system's, if any. Put one at sf2/default-GM.sf2 yourself, or set BICYCLE_DOWNLOAD_GM_SF2=OFF." )
    return()
  endif()
  file( RENAME "${dst}.part" "${dst}" )
endfunction()

# --- miniz (packer only) -----------------------------------------------------------------------------------------
# Sets BICYCLE_MINIZ_DIR (miniz.c + miniz.h).
function( bicycle_miniz )
  bicycle_fetch( miniz "${BICYCLE_MINIZ_URL}" ${BICYCLE_MINIZ_SHA256} src )
  set( BICYCLE_MINIZ_DIR "${src}" PARENT_SCOPE )
endfunction()

# --- SDL3 (2D and 3D modes) --------------------------------------------------------------------------------------
# Defines bicycle_sdl3: SDL3, static.
function( bicycle_sdl3 )
  if ( BICYCLE_USE_SYSTEM_DEPS )
    find_package( SDL3 CONFIG QUIET )
    if ( SDL3_FOUND )
      add_library( bicycle_sdl3 INTERFACE )
      if ( TARGET SDL3::SDL3-static )
        target_link_libraries( bicycle_sdl3 INTERFACE SDL3::SDL3-static )
      else()
        target_link_libraries( bicycle_sdl3 INTERFACE SDL3::SDL3 )
      endif()
      message( STATUS "bicycle: SDL3 (system)" )
      return()
    endif()
  endif()
  bicycle_fetch( sdl3 "${BICYCLE_SDL3_URL}" ${BICYCLE_SDL3_SHA256} src )
  bicycle_build_cmake_dep( sdl3 "${src}"
    -DSDL_SHARED=OFF -DSDL_STATIC=ON -DSDL_TEST_LIBRARY=OFF -DSDL_TESTS=OFF -DSDL_EXAMPLES=OFF
    -DSDL_INSTALL_DOCS=OFF -DSDL_DISABLE_INSTALL_DOCS=ON -DSDL_CAMERA=OFF -DSDL_SENSOR=OFF -DSDL_HAPTIC=OFF
    -DSDL_JOYSTICK=OFF -DSDL_HIDAPI=OFF -DSDL_POWER=OFF -DSDL_AUDIO=OFF -DSDL_GPU=OFF -DSDL_VULKAN=OFF
    -DSDL_DIALOG=OFF -DSDL_TRAY=OFF -DSDL_PIPEWIRE=OFF -DSDL_PULSEAUDIO=OFF -DSDL_ALSA=OFF -DSDL_JACK=OFF
    -DSDL_SNDIO=OFF -DSDL_IBUS=OFF -DSDL_LIBURING=OFF -DSDL_DBUS=OFF -DSDL_LIBUDEV=OFF
    -DSDL_X11_XTEST=OFF -DSDL_X11_XSCRNSAVER=OFF )
  find_package( SDL3 CONFIG REQUIRED PATHS "${BICYCLE_DEPS_PREFIX}" NO_DEFAULT_PATH )
  add_library( bicycle_sdl3 INTERFACE )
  target_link_libraries( bicycle_sdl3 INTERFACE SDL3::SDL3-static )
  message( STATUS "bicycle: SDL3 3.4.18 (fetched, static)" )
endfunction()
