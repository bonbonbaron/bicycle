#pragma GCC diagnostic push
#pragma GCC diagnostic ignored "-Wunused-function-Wunused-function"
template<typename T>
struct LWorldArr {
  T* arr;
  unsigned len;
};

template<typename T>
LWorldArr<T> World_getArr() {
  auto& arr = World::get<T>();
  return { arr.data(), static_cast<unsigned>(arr.size()) };
}

extern "C" {
  static LWorldArr<Rect> World_getRects() { return World_getArr<Rect>(); }
  static LWorldArr<CollRect> World_getCollRects() { return World_getArr<CollRect>(); }
  static LWorldArr<Image> World_getImages() { return World_getArr<Image>(); }
}

