.PHONY : tests/codec_test.o

# target to build an object file
tests/codec_test.cpp.o:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/bicycle-tests.dir/build.make CMakeFiles/bicycle-tests.dir/tests/codec_test.cpp.o
.PHONY : tests/codec_test.cpp.o

tests/codec_test.i: tests/codec_test.cpp.i
.PHONY : tests/codec_test.i

# target to preprocess a source file
tests/codec_test.cpp.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/bicycle-tests.dir/build.make CMakeFiles/bicycle-tests.dir/tests/codec_test.cpp.i
.PHONY : tests/codec_test.cpp.i

tests/codec_test.s: tests/codec_test.cpp.s
.PHONY : tests/codec_test.s

# target to generate assembly for a file
tests/codec_test.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/bicycle-tests.dir/build.make CMakeFiles/bicycle-tests.dir/tests/codec_test.cpp.s
.PHONY : tests/codec_test.cpp.s

